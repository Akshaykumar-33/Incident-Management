# Copy to .env.local (never commit). Dev Slack app for local serve.

BUG_FIX_SLACK_BOT_TOKEN=xoxb-...
BUG_FIX_SLACK_APP_TOKEN=xapp-...

# Live target app repository (required for real fixes/PRs).
BUG_FIX_REPO=owner/name
BUG_FIX_DEFAULT_BRANCH=main
# Optional override for clone/worktree location:
# BUG_FIX_WORK_DIR=/tmp/bug-fix-workspace
BUG_FIX_CHECK_CMD=npm test

# GitHub token with contents + pull_requests write on BUG_FIX_REPO.
GITHUB_TOKEN=ghp_...

# Offline / evals only (do not set in production):
# BUG_FIX_USE_FIXTURE=1
